# ============================================================================
# Personal Social Publishing OS - environment template
# Copy to `.env` (gitignored) or paste values into GitHub repo Secrets.
# NEVER commit the real values. Rotate any key that has ever been exposed.
# ============================================================================

# --- NVIDIA NIM (AI generation) -------------------------------------------
# Get: https://build.nvidia.com -> pick a model -> "Get API Key" (nvapi-...)
NVIDIA_API_KEY=nvapi-your-key-here
# Any chat model on https://build.nvidia.com (default is live-verified):
NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Nemotron reasoning models: false = clean final answers (recommended).
NIM_THINKING=false

# --- Buffer (publishing) ---------------------------------------------------
# Get: https://buffer.com/developers/applications -> create app -> generate
# token ("Public API token", works with the GraphQL API used by this repo).
BUFFER_API_KEY=your-buffer-token-here
# Optional: override the GraphQL endpoint (default https://api.buffer.com)
# BUFFER_API_BASE=https://api.buffer.com
# Optional: seconds between consecutive thread items (default 90)
# BUFFER_THREAD_GAP_SECONDS=90

# --- Discord (review surface + notifications) ------------------------------
# Get: https://discord.com/developers/applications -> New Application -> Bot
# -> Reset Token. Invite with scopes "bot applications.commands".
DISCORD_BOT_TOKEN=your-bot-token-here
# Your server id (right-click server -> Copy Server ID; enable Developer Mode)
# Setting this makes slash commands appear instantly.
DISCORD_GUILD_ID=
# Purpose-routed channels (enable Developer Mode, right-click channel -> Copy ID)
DISCORD_CHANNEL_GENERAL=
DISCORD_CHANNEL_REVIEW=
DISCORD_CHANNEL_ALERTS=
DISCORD_CHANNEL_ANALYTICS=
DISCORD_CHANNEL_ERRORS=
DISCORD_CHANNEL_STRATEGY=
# Alternative to the bot: a channel webhook URL (webhook wins if both set)
DISCORD_WEBHOOK_URL=
# Discord usernames/IDs allowed to /approve /reject /iterate /killswitch
# (fallback: config/security.yml authorized_users; guild owner always allowed
#  unless DISCORD_ALLOW_GUILD_OWNER=false)
DISCORD_AUTHORIZED_USERS=
DISCORD_ALLOW_GUILD_OWNER=true

# --- State database ---------------------------------------------------------
# Production (recommended): Supabase -> Project Settings -> Database ->
# Connection string (URI, session pooler). Apply migrations/001_init.sql.
# DATABASE_URL=postgresql://postgres:...@...pooler.supabase.com:5432/postgres
# Local/dev alternative: SQLite file (omit for :memory:)
SQLITE_PATH=data/agent.db

# --- GitHub review surface (workflow runtime fills most of these) ----------
# AUTHORIZED_REVIEWERS=ansaribilal14        # env override for issue commands
# GH_PAT=ghp_...                            # optional PAT override in Actions

# --- Master switch ----------------------------------------------------------
# The authoritative kill switch lives in the DB settings table
# (SOCIAL_AUTOMATION_ENABLED) and is controlled via /killswitch or
# scripts/run_pipeline.py --stage maintenance. Fail-safe default: OFF.
